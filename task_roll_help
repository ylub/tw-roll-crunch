def render_chain_details(
    tasks: list[dict[str, Any]], number: int, theme: dict[str, str] | None = None,
    capacities: dict[str, float | None] | None = None,
    calendar: dict[dt.date, float] | None = None,
) -> str:
    paths = sorted_chain_paths(tasks)
    if number < 1 or number > len(paths):
        return f"ERROR: Chain {number} is not listed. Run task chain.\n"
    theme = theme or {}
    capacities = capacities or {}
    path = paths[number - 1]
    root, leaf = path[0], path[-1]
    lines = [
        f"CHAIN {number} — {task_label(root)} to {task_label(leaf)}",
        "",
        paint(f'{"ID":>4}  {"TASK":<28}  {"STATUS":<8}  {("DUE (LOCAL)" if calendar is not None else "DUE"):<16}  {"REMAINING":<10}  {("WORK GAP" if calendar is not None else "GAP")!s:<8}  R', theme.get("header", "")),
    ]
    for index, task in enumerate(path):
        task_id = str(task.get("id") or task.get("uuid", "")[:8])
        label = task_label(task)[len(task_id):].strip()[:28]
        due = parse_date(task.get("due"))
        marker = task.get("r_mark") or r_mark_for(task) or "—"
        task_id = paint(f"{task_id:>4}", theme.get("child", ""))
        if calendar is not None and index:
            predecessor = path[index - 1]
            before = parse_date(predecessor.get("due"))
            if before and due:
                lines.extend(f"      Calendar break: {item}" for item in long_breaks(before, due, calendar))
        lines.append(
            f"{task_id}  {label:<28}  {str(task.get('status') or '—'):<8}  "
            f"{(due.astimezone() if calendar is not None else due).strftime('%Y-%m-%d %H:%M') if due else '—':<16}  {short_duration(task.get('remaining')):<10}  "
            f"{short_duration(task.get('roll_offset')):<8}  {marker}"
        )
    if milestone_kind(leaf) == "finish-line":
        plan = rock_plan(tasks, str(leaf.get("uuid")), calendar)
        slack = weekday_capacity_slack(plan, capacities.get(str(leaf.get("project") or "")), calendar=calendar)
        capacity = f"{slack:+g}h" if slack is not None else "—"
        deadline = parse_date(leaf.get("due"))
        status = rock_status(plan)
        if plan.get("boundary"):
            lines.extend(("", f"ROCK: deadline {deadline.date() if deadline else '—'}  capacity {capacity}",
                          status, "Backward planning stops here; full-path capacity is unavailable."))
        else:
            lines.extend(("", f"ROCK: deadline {deadline.date() if deadline else '—'}  capacity {capacity}  {status}"))
    return "\n".join(lines) + "\n"


