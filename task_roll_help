def task_command() -> str:
    return os.environ.get("TASKWARRIOR_ROLL_TASK") or shutil.which("task") or "task"


def ansi(spec: str) -> str:
    """Convert common Taskwarrior theme colors to ANSI."""
    codes = []
    background = False
    named = {
        "black": 0,
        "red": 1,
        "green": 2,
        "yellow": 3,
        "blue": 4,
        "magenta": 5,
        "cyan": 6,
        "white": 7,
    }
    styles = {"bold": 1, "dim": 2, "italic": 3, "underline": 4, "inverse": 7}
    for token in spec.lower().split():
        if token == "on":
            background = True
        elif token in styles:
            codes.append(str(styles[token]))
        elif match := re.fullmatch(r"rgb([0-5])([0-5])([0-5])", token):
            red, green, blue = (int(value) for value in match.groups())
            codes.extend(("48" if background else "38", "5", str(16 + 36 * red + 6 * green + blue)))
        elif match := re.fullmatch(r"color([0-9]{1,3})", token):
            codes.extend(("48" if background else "38", "5", match.group(1)))
        elif match := re.fullmatch(r"gray([0-9]|1[0-9]|2[0-3])", token):
            codes.extend(("48" if background else "38", "5", str(232 + int(match.group(1)))))
        elif token in named:
            codes.append(str((40 if background else 30) + named[token]))
    return f"\033[{';'.join(codes)}m" if codes else ""


def active_theme(command: str) -> dict[str, str]:
    if not sys.stdout.isatty() or "NO_COLOR" in os.environ or os.environ.get("TERM") == "dumb":
        return {}
    try:
        result = subprocess.run(
            [command, "rc.hooks=0", "rc.context=", "_show"],
            check=True,
            capture_output=True,
            text=True,
        )
        config = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
        return {
            "header": ansi(config.get("color.header", "")),
            "accent": ansi(config.get("color.uda.roll", "")),
            "child": ansi(config.get("color.active", "")),
            "warning": ansi(config.get("color.warning", "")),
        }
    except Exception:
        return {}


def paint(text: str, color: str = "") -> str:
    return f"{color}{text}\033[0m" if color else text


def render_help(
    theme: dict[str, str] | None = None, help_text: str = ROLL_HELP
) -> str:
    theme = theme or {}
    lines = []
    for line in help_text.splitlines():
        if line.startswith("Taskwarrior ") or line in {
            "Start here",
            "How Roll reads",
            "How Rock reads",
            "Fixed dates",
            "Link a task",
            "Pause at a checkpoint",
            "Keep a once-daily gap",
            "Set a finish-line on an existing linked final task",
            "Queue one same-name task after completion",
            "Fix roll:P1D mistake",
            "Limits",
        }:
            line = paint(line, theme.get("header", ""))
        elif line.startswith("  "):
            match = re.fullmatch(r"(  )(.*?)(\s{2,})(\S.*)", line)
            if match:
                line = f"{match.group(1)}{paint(match.group(2), theme.get('accent', ''))}{match.group(3)}{match.group(4)}"
            else:
                line = f"  {paint(line.strip(), theme.get('accent', ''))}"
        elif line.startswith("Never use"):
            line = paint(line, theme.get("warning", ""))
        lines.append(line)
    return "\n".join(lines) + "\n"


def short_duration(value: Any) -> str:
    text = str(value or "").upper()
    match = re.fullmatch(
        r"P(?:(?P<w>[0-9.]+)W)?(?:(?P<d>[0-9.]+)D)?"
        r"(?:T(?:(?P<h>[0-9.]+)H)?(?:(?P<m>[0-9.]+)M)?(?:(?P<s>[0-9.]+)S)?)?",
        text,
    )
    if not match:
        return text or "—"
    return " ".join(
        f"{number}{unit}"
        for unit, number in match.groupdict().items()
        if number
    )


def parse_duration(value: Any) -> dt.timedelta | None:
    text = str(value or "").strip().upper()
    if not text:
        return None
    short = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)([SMHDW])", text)
    if short:
        return dt.timedelta(seconds=float(short.group(1)) * {
            "S": 1, "M": 60, "H": 3600, "D": 86400, "W": 604800,
        }[short.group(2)])
    match = re.fullmatch(
        r"P(?:(?P<w>[0-9.]+)W)?(?:(?P<d>[0-9.]+)D)?"
        r"(?:T(?:(?P<h>[0-9.]+)H)?(?:(?P<m>[0-9.]+)M)?(?:(?P<s>[0-9.]+)S)?)?",
        text,
    )
    if not match or not any(match.groupdict().values()):
        return None
    return dt.timedelta(
        weeks=float(match["w"] or 0), days=float(match["d"] or 0),
        hours=float(match["h"] or 0), minutes=float(match["m"] or 0),
        seconds=float(match["s"] or 0),
    )


def parse_date(value: Any) -> dt.datetime | None:
    for fmt in ("%Y%m%dT%H%M%SZ", "%Y-%m-%dT%H:%M:%SZ"):
        try:
            return dt.datetime.strptime(str(value), fmt).replace(tzinfo=dt.timezone.utc)
        except (TypeError, ValueError):
            pass
    return None


def parse_day(value: str) -> dt.date | None:
    try:
        return dt.date.fromisoformat(value)
    except ValueError:
        return None


def format_duration(value: dt.timedelta) -> str:
    seconds = int(value.total_seconds())
    if seconds <= 0:
        raise ValueError("Duration must be positive.")
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    if days and not hours and not minutes and not seconds:
        return f"P{days}D"
    date_part = f"{days}D" if days else ""
    time_part = "".join(
        part for part in (f"{hours}H" if hours else "", f"{minutes}M" if minutes else "", f"{seconds}S" if seconds else "") if part
    )
    return f"P{date_part}T{time_part}"


def weekday_dates(
    start: dt.date, finish: dt.date, count: int,
    calendar: dict[dt.date, float] | None = None, hard_finish: bool = False,
) -> list[dt.date]:
    if calendar is None and (start.weekday() > 4 or finish.weekday() > 4):
        raise ValueError("Start and finish must both be weekdays.")
    if calendar is not None and (not availability(calendar, start) or (not hard_finish and not availability(calendar, finish))):
        raise ValueError("Start and flexible finish must be available work dates.")
    dates: list[dt.date] = []
    current = start
    while current <= finish:
        if (calendar is None and current.weekday() < 5) or (calendar is not None and availability(calendar, current)):
            dates.append(current)
        current += dt.timedelta(days=1)
    if count < 2:
        raise ValueError("Chain needs at least two tasks.")
    if calendar is not None:
        if not dates:
            raise ValueError("No available dates in chain range.")
        weights = [capacity_fraction(calendar, day) for day in dates]
        total = sum(weights)
        cumulative = []
        running = 0.0
        for weight in weights:
            running += weight
            cumulative.append(running)
        chosen = [dates[min(range(len(dates)), key=lambda pos: abs(cumulative[pos] - total * index / (count - 1)))] for index in range(count)]
        chosen[0] = start
        chosen[-1] = finish
        return chosen
    # Spread the ordered list over the requested range.  Repeated dates are
    # intentional: a Roll link with P0D is how several small tasks share a day.
    return [dates[round(index * (len(dates) - 1) / (count - 1))] for index in range(count)]


def read_chain(path: str) -> list[str]:
    try:
        if path == "-":
            source = sys.stdin.read()
        else:
            with open(path, encoding="utf-8") as input_file:
                source = input_file.read()
    except OSError as exc:
        raise ValueError(f"Cannot read {path!r}: {exc}") from exc
    uuids: list[str] = []
    for number, line in enumerate(source.splitlines(), 1):
        if not line.strip():
            continue
        match = re.fullmatch(r"\s*(?:-\s*)?([0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}):.+", line)
        if not match:
            raise ValueError(f"Line {number} is not UUID:description.")
        uuid = match.group(1).lower()
        if uuid in uuids:
            raise ValueError(f"Line {number} repeats {uuid}.")
        uuids.append(uuid)
    if len(uuids) < 2:
        raise ValueError("Chain needs at least two UUID:description lines.")
    return uuids


def parse_chain(arguments: list[str]) -> dict[str, Any]:
    options: dict[str, Any] = {"apply": False}
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument == "--apply":
            options["apply"] = True
        elif argument in {"--start", "--finish", "--remaining"}:
            index += 1
            if index == len(arguments):
                raise ValueError(f"{argument} needs a value.")
            options[argument[2:]] = arguments[index]
        elif argument == "-" and "file" not in options:
            options["file"] = argument
        elif argument.startswith("-"):
            raise ValueError(f"Unknown option {argument!r}.")
        elif "file" not in options:
            options["file"] = argument
        else:
            raise ValueError("Chain accepts one input file, or - for stdin.")
        index += 1
    missing = [name for name in ("file", "start", "finish") if name not in options]
    if missing:
        raise ValueError("Missing " + ", ".join(f"--{name}" for name in missing) + ".")
    start = parse_day(options["start"])
    finish = parse_day(options["finish"])
    if start is None or finish is None:
        raise ValueError("Use YYYY-MM-DD for --start and --finish.")
    if finish < start:
        raise ValueError("Finish must not precede start.")
    if "remaining" in options:
        duration = parse_duration(options["remaining"])
        if duration is None or duration.total_seconds() <= 0:
            raise ValueError("--remaining needs a positive duration such as 40m.")
        options["remaining"] = format_duration(duration)
    options.update(start=start, finish=finish)
    return options


def chain_candidate(
    tasks: list[dict[str, Any]], options: dict[str, Any], hard_finish: bool = False,
    calendar: dict[dt.date, float] | None = None,
) -> tuple[list[dict[str, Any]], list[str]]:
    selected = read_chain(options["file"])
    dates = weekday_dates(options["start"], options["finish"], len(selected), calendar, hard_finish)
    by_uuid = {str(task.get("uuid", "")).lower(): task for task in tasks}
    missing = [uuid for uuid in selected if uuid not in by_uuid]
    if missing:
        raise ValueError("Task missing: " + ", ".join(missing))
    inactive = [task_label(by_uuid[uuid]) for uuid in selected if by_uuid[uuid].get("status") not in {"pending", "waiting"}]
    if inactive:
        raise ValueError("Chain tasks must be pending or waiting: " + ", ".join(inactive))
    if not options.get("remaining"):
        missing_estimates = [
            task_label(by_uuid[uuid]) for uuid in selected if not by_uuid[uuid].get("remaining")
        ]
        if missing_estimates:
            raise ValueError("Missing remaining estimate: " + ", ".join(missing_estimates))
    candidate = [dict(task) for task in tasks]
    candidate_by_uuid = {str(task.get("uuid", "")).lower(): task for task in candidate}
    final_due = parse_date(candidate_by_uuid[selected[-1]].get("due"))
    due_time = final_due.strftime("%H%M%SZ") if final_due else "160000Z"
    local_time = final_due.astimezone().time().replace(tzinfo=None) if final_due else dt.time(16)
    for index, uuid in enumerate(selected):
        task = candidate_by_uuid[uuid]
        if options.get("remaining"):
            task["remaining"] = options["remaining"]
        scheduled_time = local_time
        if calendar is not None and not (hard_finish and index == len(selected) - 1):
            end = dt.time(12 if availability(calendar, dates[index]) == 0.5 else 17)
            scheduled_time = min(max(local_time, dt.time(8, 45)), end)
        task["due"] = (
            dt.datetime.combine(dates[index], scheduled_time).astimezone(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            if calendar is not None else dates[index].strftime("%Y%m%dT") + due_time
        )
        task.pop("roll_slack", None)
        if index == 0:
            task.pop("roll", None)
            task.pop("roll_offset", None)
            task.pop("roll_fixed", None)
            task["wait"] = dates[index].isoformat()
            continue
        task["roll"] = selected[index - 1]
        if calendar is None:
            gap = dates[index] - dates[index - 1]
        else:
            gap = work_between(parse_date(candidate_by_uuid[selected[index - 1]]["due"]), parse_date(task["due"]), calendar)
        task["roll_offset"] = (format_work_duration(gap) if calendar is not None else format_duration(gap)) if gap > dt.timedelta() else "P0D"
        if hard_finish and index == len(selected) - 1:
            task["roll_fixed"] = "finish-line"
        else:
            task.pop("roll_fixed", None)
    return candidate, selected


def render_chain_plan(
    candidate: list[dict[str, Any]], selected: list[str], options: dict[str, Any], hard_finish: bool,
    calendar: dict[dt.date, float] | None = None,
) -> str:
    body = (
        render_rock_plan(rock_plan(candidate, selected[-1], calendar), calendar).rstrip()
        if hard_finish else render_rolls(candidate, calendar=calendar).rstrip()
    )
    lines = [
        "CHAIN — selected Roll schedule",
        "",
        (f"Tasks: {len(selected)}  Remaining: {options.get('remaining', 'preserve each')}  "
         f"{'Available dates' if calendar is not None else 'Weekdays only'}"),
        body,
    ]
    if not options["apply"]:
        lines.extend(("", "DRY RUN — rerun with --apply to write this chain."))
    return "\n".join(lines) + "\n"


def modify_task(command: str, task: dict[str, Any], hooks: bool) -> None:
    arguments = [command, "rc.context=", "rc.confirmation=off"]
    if not hooks:
        arguments.append("rc.hooks=0")
    arguments.extend((str(task["uuid"]), "modify"))
    for field in ("remaining", "due", "wait", "roll", "roll_offset", "roll_fixed"):
        value = task.get(field)
        arguments.append(f"{field}:{value}" if value else f"{field}:")
    subprocess.run(arguments, check=True, capture_output=True, text=True)


def chain(arguments: list[str], hard_finish: bool = False) -> int:
    try:
        if not arguments or arguments in (["help"], ["--help"]):
            print(render_help(active_theme(task_command()), CHAIN_HELP), end="")
            return 0
        options = parse_chain(arguments)
        command = task_command()
        result = subprocess.run(
            [command, "rc.hooks=0", "rc.context=", "rc.json.array=on", "export"],
            check=True, capture_output=True, text=True,
        )
        tasks = json.loads(result.stdout or "[]")
        tasks = tasks if isinstance(tasks, list) else [tasks]
        calendar = load_calendar(command)
        candidate, selected = chain_candidate(tasks, options, hard_finish, calendar)
        candidate_by_uuid = {str(task["uuid"]).lower(): task for task in candidate}
        warnings = validate_tasks([candidate_by_uuid[uuid] for uuid in selected])
        if hard_finish:
            warnings.extend(rock_plan(candidate, selected[-1], calendar).get("warnings", []))
        if warnings:
            raise ValueError("; ".join(dict.fromkeys(warnings)))
        print(render_chain_plan(candidate, selected, options, hard_finish, calendar), end="")
        if not options["apply"]:
            return 0
        for uuid in selected[1:]:
            modify_task(command, candidate_by_uuid[uuid], hooks=False)
        modify_task(command, candidate_by_uuid[selected[0]], hooks=True)
        ending = "is finish-line" if hard_finish else "is flexible Roll"
        print(f"APPLIED: {len(selected)} tasks; {task_label(candidate_by_uuid[selected[-1]])} {ending} {options['finish']}.")
        return 0
    except Exception as exc:
        print(f"Roll chain blocked: {exc}", file=sys.stderr)
        return 1


def milestone_kind(task: dict[str, Any]) -> str | None:
    value = str(task.get("roll_fixed") or "").strip().lower()
    if value in {"1", "yes", "true", "on", "fixed"}:
        return "finish-line"
    return value if value in {"checkpoint", "vacation", "off", "night", "finish-line"} else None


def r_mark_for(task: dict[str, Any]) -> str | None:
    kind = milestone_kind(task)
    if kind == "checkpoint":
        return "󰩈 checkpoint"
    if kind == "vacation":
        return "󰂒 vacation"
    if kind == "off":
        return "󱁕 off"
    if kind == "night":
        return "󰖔 night"
    if kind == "finish-line":
        return " finish-line"
    if task.get("roll"):
        return f"󰍃 +{short_duration(task.get('roll_offset'))}"
    return None


def task_label(task: dict[str, Any]) -> str:
    return f'{task.get("id", "—")} {task.get("description", "")}'.strip()


def find_task(tasks: list[dict[str, Any]], selector: str) -> dict[str, Any] | None:
    matches = [task for task in tasks if str(task.get("id")) == selector]
    if not matches:
        matches = [task for task in tasks if str(task.get("uuid", "")).startswith(selector)]
    return matches[0] if len(matches) == 1 else None


def config_value(command: str, key: str) -> str | None:
    result = subprocess.run(
        [command, "rc.hooks=0", "rc.context=", "show", key],
        check=False, capture_output=True, text=True,
    )
    for line in result.stdout.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and parts[0] == key:
            return parts[1].strip() or None
    return None


def project_capacity(command: str, project: str | None, cache: dict[str, float | None]) -> float | None:
    """Return longest dotted-project weekly capacity."""
    if not project:
        return None
    if project in cache:
        return cache[project]
    parts = project.split(".")
    for length in range(len(parts), 0, -1):
        raw = config_value(command, "roll.capacity." + ".".join(parts[:length]))
        if raw is None:
            continue
        try:
            capacity = float(raw)
        except ValueError:
            break
        cache[project] = capacity if capacity > 0 else None
        return cache[project]
    cache[project] = None
    return None


def capacity_map(command: str, tasks: list[dict[str, Any]]) -> dict[str, float | None]:
    cache: dict[str, float | None] = {}
    return {
        project: project_capacity(command, project, cache)
        for project in {str(task.get("project") or "") for task in tasks}
        if project
    }


def weekday_capacity_slack(
    plan: dict[str, Any], weekly_hours: float | None, now: dt.datetime | None = None,
    calendar: dict[dt.date, float] | None = None,
) -> float | None:
    """Daily work capacity from today through the finish-line, minus remaining work."""
    if weekly_hours is None or not plan.get("root"):
        return None
    deadline = parse_date(plan["finish"].get("due"))
    if deadline is None:
        return None
    remaining = []
    for task, _ in plan["path"]:
        duration = parse_duration(task.get("remaining"))
        if duration is None:
            return None
        remaining.append(duration.total_seconds() / 3600)
    today = (now or dt.datetime.now(dt.timezone.utc)).astimezone().date() if calendar is not None else (now or dt.datetime.now(dt.timezone.utc)).date()
    last = deadline.astimezone().date() if calendar is not None else deadline.date()
    days = (last - today).days + 1 if last >= today else 0
    if calendar is None:
        return days * weekly_hours / 7 - sum(remaining)
    available = sum(capacity_fraction(calendar, today + dt.timedelta(days=index)) for index in range(days))
    return available * weekly_hours / 6 - sum(remaining)


def rock_plan(
    tasks: list[dict[str, Any]], selector: str,
    calendar: dict[dt.date, float] | None = None,
) -> dict[str, Any]:
    by_uuid = {str(task["uuid"]): task for task in tasks if task.get("uuid")}
    finish = find_task(tasks, selector)
    warnings: list[str] = []
    if not finish:
        return {"warnings": [f"No unique task matches {selector!r}."]}
    if milestone_kind(finish) != "finish-line":
        return {"finish": finish, "warnings": ["Rock needs roll_fixed:finish-line."]}
    required = parse_date(finish.get("due"))
    if finish.get("status") not in {"pending", "waiting"} or required is None:
        return {"finish": finish, "warnings": ["Finish-line needs active status and due date."]}
    if not finish.get("roll"):
        return {"finish": finish, "warnings": ["Finish-line needs a Roll predecessor."]}

    path = [(finish, required)]
    current = finish
    seen: set[str] = set()
    while current.get("roll"):
        uuid = str(current.get("uuid", ""))
        if uuid in seen:
            warnings.append("Roll cycle blocks Rock.")
            break
        seen.add(uuid)
        offset = parse_duration(current.get("roll_offset"))
        if offset is None:
            warnings.append(f"{task_label(current)} has invalid/missing roll_offset.")
            break
        predecessor = by_uuid.get(str(current["roll"]))
        if not predecessor:
            warnings.append(f"{task_label(current)} has missing predecessor.")
            break
        if predecessor.get("status") not in {"pending", "waiting"}:
            warnings.append(f"{task_label(predecessor)} is completed or inactive.")
            break
        required = move_work(required, -work_duration(current.get("roll_offset"), offset), calendar,
                             forward_on_zero=False) if calendar is not None else required - offset
        kind = milestone_kind(predecessor)
        if kind in {"checkpoint", "vacation", "off", "night"}:
            checkpoint_due = parse_date(predecessor.get("due"))
            detail = f"; fixed {checkpoint_due.date()}" if checkpoint_due else ""
            warnings.append(
                f"{kind.title()} {task_label(predecessor)} stops Rock: needs {required.date()}{detail}."
            )
            return {"finish": finish, "path": path, "warnings": warnings,
                    "boundary": (kind, predecessor, checkpoint_due, required)}
        path.append((predecessor, required))
        current = predecessor

    if warnings:
        return {"finish": finish, "path": path, "warnings": warnings}
    root, start = path[-1]
    next_uuid = str(path[-2][0].get("uuid", "")) if len(path) > 1 else ""
    branches = [
        task for task in tasks
        if task.get("status") in {"pending", "waiting"}
        and str(task.get("roll") or "") == str(root.get("uuid", ""))
        and str(task.get("uuid", "")) != next_uuid
    ]
    if branches:
        warnings.append(f"Changing {task_label(root)} also rolls {len(branches)} other active branch(es).")
    return {"finish": finish, "path": path, "root": root, "start": start, "warnings": warnings}


def rock_status(plan: dict[str, Any]) -> str:
    if boundary := plan.get("boundary"):
        kind, task, fixed, needed = boundary
        if fixed is None:
            return f"WARN: {kind.title()} {task_label(task)} has no fixed due date."
        days = abs((needed.date() - fixed.date()).days)
        day_count = f"{days} calendar day{'s' if days != 1 else ''}"
        same_day = fixed.date() == needed.date()
        fixed_at = fixed.strftime("%Y-%m-%d %H:%M UTC") if same_day else str(fixed.date())
        needed_at = needed.strftime("%Y-%m-%d %H:%M UTC") if same_day else str(needed.date())
        if fixed <= needed:
            timing = f"{day_count} later" if days else "same day"
            return f"{kind.upper()}: {task_label(task)} fixed {fixed_at}; Rock needs it by {needed_at} ({timing})."
        timing = f"{day_count} earlier" if days else "earlier that day"
        return f"WARN: {kind.title()} {task_label(task)} fixed {fixed_at}; Rock needs it by {needed_at} ({timing})."
    return "READY" if plan.get("root") and not plan["warnings"] else "WARN: " + plan["warnings"][0]


def render_rock_plan(
    plan: dict[str, Any], calendar: dict[dt.date, float] | None = None,
) -> str:
    if not plan.get("root"):
        if plan.get("boundary"):
            return ("ROCK — plan from a solid deadline\n\n"
                    f"Deadline: {parse_date(plan['finish'].get('due')).date()}\n"
                    f"{rock_status(plan)}\n"
                    "Backward planning stops here; full-path capacity is unavailable.\n")
        return "ROCK — plan from a solid deadline\n\nBLOCKED: " + " ".join(plan["warnings"]) + "\n"
    finish = plan["finish"]
    root = plan["root"]
    start = plan["start"]
    path = " > ".join(task_label(task) for task, _ in reversed(plan["path"]))
    lines = [
        "ROCK — plan from a solid deadline",
        "",
        f"Deadline: {(parse_date(finish.get('due')).astimezone() if calendar is not None else parse_date(finish.get('due'))).date()}  {task_label(finish)}",
        f"Start needed: {(start.astimezone() if calendar is not None else start).date()}  {task_label(root)}",
        f"Path: {path}",
        "",
        "DRY RUN — apply this one anchor change:",
        f"task {root['uuid']} modify due:{start.strftime('%Y%m%dT%H%M%SZ')}",
    ]
    if calendar is not None:
        breaks = [
            item for (_, later), (_, earlier) in zip(plan["path"], plan["path"][1:])
            for item in long_breaks(earlier, later, calendar)
        ]
        lines.extend(f"Calendar break: {item}" for item in dict.fromkeys(breaks))
    lines.extend(f"WARN: {warning}" for warning in plan["warnings"])
    return "\n".join(lines) + "\n"


def apply_rock_plan(plan: dict[str, Any], command: str) -> None:
    if not plan.get("root"):
        raise ValueError("Rock plan is blocked.")
    if plan["warnings"]:
        raise ValueError("Rock --apply refuses plans with warnings.")
    subprocess.run(
        [
            command,
            "rc.context=",
            str(plan["root"]["uuid"]),
            "modify",
            f"due:{plan['start'].strftime('%Y%m%dT%H%M%SZ')}",
        ],
        check=True,
    )


def render_rolls(
    tasks: list[dict[str, Any]], theme: dict[str, str] | None = None,
    calendar: dict[dt.date, float] | None = None,
) -> str:
    theme = theme or {}
    by_uuid = {str(task["uuid"]): task for task in tasks if task.get("uuid")}
    active = {
        uuid: task
        for uuid, task in by_uuid.items()
        if task.get("status") in {"pending", "waiting"}
    }
    rows = []
    ignored = []
    for task in active.values():
        predecessor_uuid = str(task.get("roll") or "")
        predecessor = by_uuid.get(predecessor_uuid)
        if task.get("roll_offset") and not predecessor_uuid:
            ignored.append(task)
        if not task.get("roll") or milestone_kind(task) is not None:
            continue
        if predecessor:
            source_id = predecessor.get("id") or predecessor_uuid[:8]
            source = f'{source_id} {predecessor.get("description", "")}'
            source_color_id = str(source_id)
        elif predecessor_uuid:
            source = f"missing {predecessor_uuid[:8]}"
            source_color_id = ""
        else:
            source = "—"
            source_color_id = ""
        target_id = str(task.get("id", "—"))
        target = f'{target_id} {task.get("description", "")}'
        rows.append(
            (
                int(task.get("id") or 0),
                source,
                source_color_id,
                short_duration(task.get("roll_offset")),
                target_id,
                target,
                r_mark_for(task) or task.get("r_mark") or "—",
                long_breaks(parse_date(predecessor.get("due")), parse_date(task.get("due")), calendar)
                if calendar is not None and predecessor and parse_date(predecessor.get("due")) and parse_date(task.get("due")) else [],
            )
        )
    if rows:
        header = f'{"PREDECESSOR":<24}  {"WORK GAP" if calendar is not None else "GAP":<8}  {"CHILD":<24}  R'
        lines = [
            "ROLL — live schedule",
            "",
            ("Each row means: CHILD follows PREDECESSOR by an available-time WORK GAP."
             if calendar is not None else "Each row means: CHILD is due GAP after PREDECESSOR."),
            "",
            paint(header, theme.get("header", "")),
        ]
        for _, source, source_color_id, offset, target_id, target, marker, breaks in sorted(rows):
            source = source[:24]
            source_length = len(source)
            if source_color_id:
                source = paint(source_color_id, theme.get("accent", "")) + source[len(source_color_id):]
            source += " " * (24 - source_length)
            offset = f"{offset:<8}"
            target = target[:24]
            target = (
                paint(target_id, theme.get("child", ""))
                + target[len(target_id) :]
                + " " * (24 - len(target))
            )
            marker = paint(marker, theme.get("warning", "")) if marker.endswith(("checkpoint", "vacation", "off", "night", "finish-line")) else marker
            lines.extend(f"  Calendar break: {item}" for item in breaks)
            lines.append(f"{source[:24]:<24}  {offset}  {target}  {marker}")
    else:
        lines = ["No active Roll links or milestones."]
    if ignored:
        lines.append("")
        for task in sorted(ignored, key=lambda item: int(item.get("id") or 0)):
            message = (
                f'IGNORED {task.get("id", "—")} {task.get("description", "")}: '
                f'roll_offset {short_duration(task.get("roll_offset"))} needs roll:<UUID>.'
            )
            lines.append(paint(message, theme.get("warning", "")))
    return "\n".join(lines) + "\n"


def validate_tasks(tasks: list[dict[str, Any]]) -> list[str]:
    by_uuid = {str(task["uuid"]): task for task in tasks if task.get("uuid")}
    warnings = []
    for task in tasks:
        if task.get("status") not in {"pending", "waiting"}:
            continue
        if task.get("roll_offset") and not task.get("roll"):
            warnings.append(f"{task_label(task)}: roll_offset needs roll:<UUID>.")
        fixed = task.get("roll_fixed")
        if fixed and milestone_kind(task) is None:
            warnings.append(f"{task_label(task)}: invalid roll_fixed value.")
        if milestone_kind(task) and parse_date(task.get("due")) is None:
            warnings.append(f"{task_label(task)}: fixed milestone needs due date.")
        if not task.get("roll"):
            continue
        if parse_duration(task.get("roll_offset")) is None:
            warnings.append(f"{task_label(task)}: invalid/missing roll_offset.")
        predecessor = by_uuid.get(str(task["roll"]))
        if not predecessor:
            warnings.append(f"{task_label(task)}: predecessor missing.")
            continue
        if predecessor.get("status") not in {"pending", "waiting", "completed"}:
            warnings.append(f"{task_label(task)}: predecessor status unusable.")
            continue
        root = predecessor
        seen: set[str] = set()
        while root.get("roll") and str(root.get("uuid", "")) not in seen:
            seen.add(str(root.get("uuid", "")))
            root = by_uuid.get(str(root["roll"]))
            if root is None:
                break
        if root:
            base = root.get("end") if root.get("status") == "completed" else root.get("due")
            if parse_date(base) is None:
                warnings.append(f"{task_label(root)}: chain root has no due/end date.")
    for start in by_uuid:
        seen: set[str] = set()
        current = start
        while current in by_uuid and by_uuid[current].get("roll"):
            if current in seen:
                warnings.append(f"Roll cycle at {current[:8]}.")
                break
            seen.add(current)
            current = str(by_uuid[current]["roll"])
    return list(dict.fromkeys(warnings))


def active_chain_paths(tasks: list[dict[str, Any]]) -> list[list[dict[str, Any]]]:
    active = {
        str(task.get("uuid")): task
        for task in tasks
        if task.get("status") in {"pending", "waiting"} and task.get("uuid")
    }
    children: dict[str, list[str]] = {}
    for uuid, task in active.items():
        predecessor = str(task.get("roll") or "")
        if predecessor in active:
            children.setdefault(predecessor, []).append(uuid)
    paths = []
    for uuid, leaf in active.items():
        if not leaf.get("roll") or children.get(uuid):
            continue
        path = [leaf]
        seen = {uuid}
        current = leaf
        while predecessor := str(current.get("roll") or ""):
            parent = active.get(predecessor)
            if parent is None or predecessor in seen:
                break
            path.append(parent)
            seen.add(predecessor)
            current = parent
        paths.append(list(reversed(path)))
    return paths


def sorted_chain_paths(tasks: list[dict[str, Any]]) -> list[list[dict[str, Any]]]:
    return sorted(active_chain_paths(tasks), key=lambda path: int(path[-1].get("id") or 0))


def render_chain_browser(
    tasks: list[dict[str, Any]], theme: dict[str, str] | None = None,
    capacities: dict[str, float | None] | None = None,
    calendar: dict[dt.date, float] | None = None, show_breaks: bool = False,
) -> str:
    theme = theme or {}
    capacities = capacities or {}
    paths = sorted_chain_paths(tasks)
    if not paths:
        return "CHAIN — active Roll paths\n\nNo active complete Roll chains.\n"
    header = f'{"#":>2}  {"ROOT":<24}  {"TASKS":>5}  {"START":<10}  {"FINISH / LEAF":<24}  {"DEADLINE":<10}  {"CAPACITY":>9}  STATUS'
    lines = [
        "CHAIN — active Roll paths",
        "",
        "Run task chain NUMBER for every task in one path. Branches appear as separate rows.",
        "",
        paint(header, theme.get("header", "")),
    ]
    for number, path in enumerate(paths, 1):
        root, leaf = path[0], path[-1]
        root_label = task_label(root)[:24]
        leaf_label = task_label(leaf)[:24]
        root_id = str(root.get("id") or root.get("uuid", "")[:8])
        leaf_id = str(leaf.get("id") or leaf.get("uuid", "")[:8])
        root_colored = paint(root_id, theme.get("accent", "")) + root_label[len(root_id):]
        leaf_colored = paint(leaf_id, theme.get("child", "")) + leaf_label[len(leaf_id):]
        start = parse_date(root.get("due"))
        deadline = parse_date(leaf.get("due"))
        if milestone_kind(leaf) == "finish-line":
            plan = rock_plan(tasks, str(leaf.get("uuid")), calendar)
            status = rock_status(plan)
            slack = weekday_capacity_slack(plan, capacities.get(str(leaf.get("project") or "")), calendar=calendar)
            capacity = f"{slack:+g}h" if slack is not None else "—"
        else:
            status = "ROLLING"
            capacity = "—"
        if status.startswith("WARN:"):
            status = paint(status, theme.get("warning", ""))
        lines.append(
            f"{number:>2}  {root_colored}{' ' * (24 - len(root_label))}  {len(path):>5}  "
            f"{str(start.date()) if start else '—':<10}  "
            f"{leaf_colored}{' ' * (24 - len(leaf_label))}  "
            f"{str(deadline.date()) if deadline else '—':<10}  {capacity:>9}  {status}"
        )
        if show_breaks and calendar is not None:
            for predecessor, child in itertools.pairwise(path):
                before, after = parse_date(predecessor.get("due")), parse_date(child.get("due"))
                if before and after:
                    lines.extend(f"    Calendar break: {item}" for item in long_breaks(before, after, calendar))
    return "\n".join(lines) + "\n"


def render_chains(
