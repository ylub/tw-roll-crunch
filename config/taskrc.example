# Portable UDA definitions for taskwarrior-roll-crunch.
# Let a due-today warning override Crunch and ordinary due colors.
rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,uda.,due,blocked,blocking,recurring,tagged
rule.color.merge=1
color.due.today=bold
color.uda.crunch.LOW=rgb034
color.uda.crunch.MED=rgb045
color.uda.crunch.HIGH=rgb530
color.uda.crunch.CRITICAL=rgb500
color.blocking=

uda.remaining.type=duration
uda.remaining.label=Remaining

uda.progress.type=numeric
uda.progress.label=Progress

uda.crunch.type=string
uda.crunch.label=Crunch
uda.crunch.values=LOW,MED,HIGH,CRITICAL

uda.crunch_display.type=string
uda.crunch_display.label=Crunch

uda.roll.type=uuid
uda.roll.label=Roll

alias.roll=execute task_roll_help
alias.rock=execute task_rock

uda.roll_offset.type=duration
uda.roll_offset.label=Roll Offset

uda.roll_fixed.type=string
uda.roll_fixed.label=Finish-line Milestone

uda.roll_slack.type=numeric
uda.roll_slack.label=Roll Slack Hours

uda.r_mark.type=string
uda.r_mark.label=R

# Kept for one upgrade cycle so Roll can clear old marks safely.
uda.roll_mark.type=string
uda.roll_mark.label=Legacy Roll Mark
